# Copie para .env (que NÃO vai para o git) e preencha para usar o MODO CONECTADO.
# Sem nenhuma destas variáveis o front roda em MODO DEMO (dados no localStorage).
# Preencha as três ou nenhuma: configuração pela metade dá erro ao abrir o app.

# Endereço da API (backend/), ex.: http://localhost:3333
# VITE_API_URL=
# Supabase (Project Settings > API). A anon key é pública por natureza (o RLS protege os dados).
# Nunca coloque a service_role aqui: tudo que começa com VITE_ vai para o navegador.
# VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=
