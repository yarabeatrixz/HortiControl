{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@domain": ["src/0-domain"],
      "@domain/*": ["src/0-domain/*"],
      "@application": ["src/1-application"],
      "@application/*": ["src/1-application/*"],
      "@adapters": ["src/2-adapters"],
      "@adapters/*": ["src/2-adapters/*"],
      "@ui/*": ["src/3-frameworks/ui/*"]
    }
  },
  "include": ["src", "vite.config.js"]
}
