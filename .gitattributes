# Texto sempre com LF no repositório (Windows e Linux iguais; o CI roda em Linux).
* text=auto eol=lf

# Scripts do Windows precisam de CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Lockfile: sem diff gigante nos PRs e merge sem conflito manual
pnpm-lock.yaml -diff linguist-generated=true

# Binários (nunca converter fim de linha nem tentar diff)
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.mp3  binary
*.mp4  binary
*.woff binary
*.woff2 binary

# Estatística de linguagens do GitHub: documentação não conta como código
docs/** linguist-documentation
